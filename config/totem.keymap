#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
                  &kp Q  &kp W  &kp E  &kp R  &kp T      &kp Y      &kp U  &kp I      &kp O    &kp P
                  &kp A  &kp S  &kp D  &kp F  &kp G      &kp H      &kp J  &kp K      &kp L    &kp SEMI
&mt LCTRL ESCAPE  &kp Z  &kp X  &kp C  &kp V  &kp B      &kp N      &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp BACKSPACE
                                &mo 1  &mo 2  &kp TAB    &kp SPACE  &mo 4  &mo 3
            >;
        };

        base_mod_l {
            bindings = <
            &kp Q        &kp W           &kp E           &kp R             &kp T    &kp Y      &kp U      &kp I      &kp O    &kp P
            &mt LCTRL A  &mt LEFT_ALT S  &mt LEFT_GUI D  &mt LEFT_SHIFT F  &kp G    &kp H      &kp J      &kp K      &kp L    &kp SEMI
&kp ESCAPE  &kp Z        &kp X           &kp C           &kp V             &kp B    &kp N      &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp BACKSPACE
                                         &trans          &none             &none    &kp SPACE  &kp ENTER  &kp TAB
            >;
        };

        nav {
            bindings = <
            &none      &none     &none     &none      &none    &kp MINUS  &kp EQUAL       &kp LBKT      &kp RBKT   &kp BSLH
            &kp LCTRL  &kp LALT  &kp LGUI  &kp LSHFT  &none    &kp LEFT   &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT  &kp APOS
&kp ESCAPE  &none      &none     &none     &none      &none    &none      &none           &none         &none      &kp GRAVE  &kp BACKSPACE
                                 &none     &trans     &none    &kp SPACE  &kp ENTER       &kp TAB
            >;
        };

        base_mode_r {
            bindings = <
           &kp Q  &kp W  &kp E  &kp R      &kp T    &kp Y  &kp U              &kp I            &kp O            &kp P
           &kp A  &kp S  &kp D  &kp F      &kp G    &kp H  &mt RIGHT_SHIFT J  &mt RIGHT_GUI K  &mt RIGHT_ALT L  &mt RCTRL SEMI
&kp GRAVE  &kp Z  &kp X  &kp C  &kp V      &kp B    &kp N  &kp M              &kp COMMA        &kp DOT          &kp FSLH        &kp ESCAPE
                         &none  &kp ENTER  &none    &none  &trans             &trans
            >;
        };

        nums {
            bindings = <
           &none  &kp N7  &kp N8   &kp N9     &kp N0    &none  &none      &none     &none     &none
           &none  &kp N4  &kp N5   &kp N6     &none     &none  &kp RSHFT  &kp RGUI  &kp RALT  &kp RCTRL
&kp GRAVE  &none  &kp N1  &kp N2   &kp N3     &none     &none  &none      &none     &none     &none      &kp ESCAPE
                          &kp TAB  &kp ENTER  &none     &none  &trans     &trans
            >;
        };

        device {
            bindings = <
       &none       &kp LC(C_BRIGHTNESS_DEC)  &kp LC(C_BRIGHTNESS_INC)  &none             &none    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
       &kp K_MUTE  &kp C_VOLUME_DOWN         &kp C_VOLUME_UP           &kp C_PLAY_PAUSE  &none    &none         &none         &none         &none         &none
&none  &none       &none                     &none                     &none             &none    &none         &none         &none         &none         &none         &bt BT_CLR
                                             &none                     &none             &none    &none         &trans        &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        device {
            if-layers = <3 4>;
            then-layer = <5>;
        };
    };
};
